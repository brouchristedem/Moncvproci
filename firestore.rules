rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Chaque utilisateur ne peut lire/écrire que son propre document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // L'admin peut consulter (lecture seule) l'ensemble des comptes, pour
      // le tableau de statistiques de la page /admin (nombre de CV créés,
      // codes promo les plus utilisés, etc.). Aucune écriture n'est permise
      // par cette règle : l'admin ne modifie jamais le compte d'un tiers.
      allow read: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";

      // L'admin peut corriger le CV d'un utilisateur depuis /editor?cvOf=UID
      // (bouton « Enregistrer sur son compte »). Seuls les champs cv et
      // updatedAt peuvent changer : jamais les téléchargements, codes promo, etc.
      allow update: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com" &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["cv", "updatedAt"]);
    }

    // Codes promo : lecture publique (pour vérifier un code), écriture réservée à l'admin
    match /promoCodes/{code} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";

      // Exception étroite : une personne connectée peut désactiver
      // elle-même un code à usage unique juste après l'avoir utilisé avec
      // succès (actif passe de true à false, et rien d'autre que actif /
      // usedByUid / usedAt ne change). Elle ne peut ni créer, ni supprimer,
      // ni réactiver un code, ni toucher à un code à usage illimité.
      allow update: if request.auth != null &&
        resource.data.usageType == "unique" &&
        resource.data.actif == true &&
        request.resource.data.actif == false &&
        request.resource.data.usageType == "unique" &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["actif", "usedByUid", "usedAt"]);
    }

    // Réglages généraux (prix, etc.) : lecture publique, écriture admin uniquement
    match /settings/{doc} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Statut actif/inactif des templates : lecture publique, écriture admin uniquement
    match /templates/{templateId} {
      allow read: if true;
      allow write: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Journal des déclarations de paiement (lecture nécessaire pour vérifier qu'une
    // référence Wave n'est pas réutilisée deux fois)
    match /paymentClaims/{claimId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null;
      allow delete: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Journal de chaque téléchargement de CV réellement effectué (payant,
    // promo ou admin), utilisé uniquement pour le compteur "CV téléchargés"
    // du tableau de bord admin.
    match /downloads/{downloadId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }

    // Quota d'améliorations IA gratuites : un document par utilisateur et par
    // jour (aiUsage/{uid}_{AAAA-MM-JJ}). L'utilisateur ne peut que créer son
    // compteur à 1, puis l'augmenter de 1 (maximum 10) : impossible de le
    // remettre à zéro ou de lire/modifier celui d'un autre.
    match /aiUsage/{docId} {
      allow read: if request.auth != null &&
        docId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}');
      allow create: if request.auth != null &&
        docId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == 1;
      allow update: if request.auth != null &&
        docId.matches(request.auth.uid + '_[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count == resource.data.count + 1 &&
        request.resource.data.count <= 10;
    }

    // Avis clients : n'importe qui peut en déposer un (formulaire public,
    // sans compte), mais toujours avec displayed = false au départ — seul
    // l'admin peut ensuite choisir de l'afficher sur la page d'accueil.
    // Lecture publique limitée aux avis déjà validés (displayed == true) ;
    // l'admin peut tout lire pour les modérer depuis /admin.
    match /reviews/{reviewId} {
      allow create: if request.resource.data.keys().hasOnly(["nom", "texte", "note", "displayed", "createdAt"]) &&
        request.resource.data.displayed == false &&
        request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 60 &&
        request.resource.data.texte is string && request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 500 &&
        request.resource.data.note is int && request.resource.data.note >= 1 && request.resource.data.note <= 5;

      allow read: if resource.data.displayed == true ||
        (request.auth != null && request.auth.token.email == "brouchristedem@gmail.com");

      allow update, delete: if request.auth != null &&
        request.auth.token.email == "brouchristedem@gmail.com";
    }
  }
}
